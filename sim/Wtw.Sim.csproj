<Project Sdk="Microsoft.NET.Sdk">
  <!-- 시뮬 코어: Godot 를 모른다. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Wtw.Sim</RootNamespace>
    <AssemblyName>Wtw.Sim</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- 콘텐츠 데이터를 시뮬 안에 넣는다: 게임(윈도우 실행 파일) · 측정 도구 · 테스트가 같은 data/*.json 을 본다. -->
  <ItemGroup>
    <EmbeddedResource Include="../data/objects.json" LogicalName="data/objects.json" />
    <EmbeddedResource Include="../data/items.json" LogicalName="data/items.json" />
    <EmbeddedResource Include="../data/rocks.json" LogicalName="data/rocks.json" />
    <EmbeddedResource Include="../data/people.json" LogicalName="data/people.json" />
    <EmbeddedResource Include="../data/language.json" LogicalName="data/language.json" />
    <EmbeddedResource Include="../data/properties.json" LogicalName="data/properties.json" />
    <EmbeddedResource Include="../data/crafting.json" LogicalName="data/crafting.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Wtw.Sim.Tests" />
  </ItemGroup>
</Project>
